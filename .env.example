# 외부 서비스 자격증명. 사용하는 것만 채우면 된다.
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
SNOWFLAKE_USER=
# 인증은 셋 중 하나만:
SNOWFLAKE_AUTHENTICATOR=                  # externalbrowser = SSO 로그인(브라우저 열림). 서버·Airflow에서는 비워 둔다
SNOWFLAKE_PRIVATE_KEY_PATH=               # key-pair 인증 (Airflow 헤드리스용)
SNOWFLAKE_PASSWORD=                       # 서비스 유저 비밀번호
# 롤: 적재는 config.yaml의 mart.snowflake.role(SKILL_EVAL_LOADER), Grafana는 SKILL_EVAL_READER가 기본값
JEV_API_KEY=
GRAFANA_ADMIN_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
# 다른 장비에서 Kafka로 이벤트를 보낼 때만: 바인딩할 주소와 클라이언트에 알려 줄 호스트명 (포트 19093)
KAFKA_LAN_BIND=
KAFKA_LAN_HOST=
