      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS schedulers FROM job WHERE job_type = 'SchedulerJob' AND state = 'running' AND latest_heartbeat > now() - interval '60 seconds'",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-db"
          },
          "refId": "A"
